# Copy values into your shell / hosting dashboard. Spring Boot does NOT auto-load .env files.
# Never commit a real .env file.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=finpulse
GRIDFS_BUCKET=fs
# At least 32 bytes. Generate: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=11MB
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
PORT=8080
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=300
JOB_BACKOFF_BASE_SECONDS=30
JOB_BACKOFF_MAX_SECONDS=3600
DASHBOARD_CURRENCY=INR
DASHBOARD_ZONE=Asia/Kolkata
DASHBOARD_RECENT_COUNT=5
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
