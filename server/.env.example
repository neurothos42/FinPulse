# Copy values into your shell / hosting dashboard. Spring Boot does NOT auto-load .env files.
# Never commit a real .env file.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=finpulse
GRIDFS_BUCKET=fs
# At least 32 bytes. Generate: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=11MB
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
PORT=8080
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=300
JOB_BACKOFF_BASE_SECONDS=30
JOB_BACKOFF_MAX_SECONDS=3600
DASHBOARD_CURRENCY=INR
DASHBOARD_ZONE=Asia/Kolkata
DASHBOARD_RECENT_COUNT=5
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- added by backend completion ---
DOCUMENT_RECONCILE_INTERVAL_MS=60000
DOCUMENT_RECONCILE_INITIAL_DELAY_MS=30000
UPLOAD_MAX_PER_WINDOW=20
UPLOAD_WINDOW_SECONDS=60
GRIDFS_ORPHAN_SWEEP_INTERVAL_MS=3600000

# Voice expenses (Gemini). Get a key at https://aistudio.google.com/apikey - never commit it.
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=30
